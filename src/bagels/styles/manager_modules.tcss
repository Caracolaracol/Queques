/* ------------ Spending ------------ */

/* Hidden: the category budgets table needs the space. Re-enable by removing
   this rule (or display: block) if the spending module is needed again. */
#spending-container {
  display: none;
}

#spending-container {
  height: 1fr;
  layout: grid;
  grid-size: 1 3;
  grid-rows: 1 1fr 2;

  Button {
    width: auto;
  }


  & > Horizontal {
    align-horizontal: center;
  }

  & > #top-controls-container {
    & > .current-view-label {
      margin-left: 2;
      margin-right: 2;
    }
  }

  & > #bottom-controls-container {
    border-top: round $panel;
  }
}

/* ------------- Budgets ------------ */

#budgets-container {
  height: 1fr;
  overflow-y: hidden;

  & > .config-rows {
    border-bottom: round $panel;
    height: 2;
    & > Label {
      margin-right: 2;
    }
    & > Button {
      width: auto;
      margin-right: 1;
      background: $panel;
    }
    & > Input {
      dock: right;
      width: 12;

      &.invalid {
        border-left: outer $error;
      }
    }
  }

  .empty-bar {
    width: 1fr;
    height: 3;
    hatch: right $panel-lighten-2;
    align: center middle;
  }

  #income-bar {
    height: 9;
    align-vertical: middle;
    
    & > #row-0 {
      width: 1fr;
      layout: horizontal;
      height: 1;

      #remaining {
        dock: right;
        width: auto;
        opacity: 0.5;
      }
    }

    & > #row-1 {
      layout: grid;
      grid-size: 3 1;
      width: 1fr;
      height: 1;
      
      & > #bar-spent {
        background: $accent;
      }
      & > #bar-saving {
        background: $secondary;
      }
      & > #bar-remaining {
        background: $panel;
      }
    }

    & > #row-2 {
      layout: grid;
      grid-size: 2 1;
      height: 1;
    }

    & > #row-3 {
      layout: grid;
      grid-size: 3 1;
      margin-top: 1;
      height: 1;

      #want {
        align-horizontal: right;
      }
    }

    & > #row-4 {
      layout: grid;
      width: 1fr;
      grid-size: 5 1;
      height: 1;
      
      & > #bar-spent-must {
        hatch: "/" $secondary;
      }
      & > #bar-spent-need {
        hatch: "/" $success;
      }
      & > #bar-spent-want {
        hatch: "/" $accent;
      }
      & > #bar-spent-quota {
        hatch: "/" $panel;
      }
      & > Label {
        hatch: "·" $panel;
        width: 1fr;
        text-align: center;
        color: $panel;
        background: transparent;
      }
    }

    & > #row-5 {
      align-horizontal: right;
      height: 1;

      & > #bar-must-quota {
        hatch: "/" $accent;
      }
    }
  }
}

/* ----------- Categories ----------- */

.h {
  #categories-container {
    height: 1fr;
  }
}

.v {
  #categories-container {
    height: 1fr;
    width: 50;
  }
}

#categories-container {
  #categories-table {
    width: 46;
  }
}

/* ------------- People ------------- */

.h {
  .person {
    width: 1fr;
  }
}

#people-container {
  height: 1fr;
}
/* ------------- Category budgets ------------- */

#category-budgets {
  height: 1fr;
  layout: vertical;
  overflow-y: hidden;
  margin-top: 1;
  border-top: round $panel;
  padding-top: 1;

  #category-budgets-title {
    text-style: bold;
    margin-bottom: 1;
  }

  .budget-hint {
    opacity: 0.5;
    margin-bottom: 1;
  }

  .budget-rows-container {
    height: 1fr;
    overflow-y: auto;
    padding-left: 2;
  }
}

/* Budget table header + rows + total live at the module level (the total row
   is docked to the bottom of #budgets-container, outside #category-budgets). */
.budget-table-header {
  height: 1;
  padding-left: 2;

  & > Label {
    opacity: 0.8;
  }

  & > .budget-name {
    width: 1fr;
    margin-right: 2;
  }

  & > .budget-input {
    width: 12;
  }

  & > .budget-spent {
    width: 12;
    margin-right: 1;
  }

  & > .budget-left {
    width: 12;
    margin-right: 1;
  }
}

.budget-row {
  height: 1;

  &.zebra-b {
    background: $panel-darken-1;
  }

  &.budget-total {
    height: 2;
    border-top: heavy $panel-lighten-1;
    background: $panel-darken-1;
    dock: bottom;
    width: 1fr;
    padding-left: 2;
  }

  & > .budget-name {
    width: 1fr;
    margin-right: 2;
  }

  & > .budget-spent {
    opacity: 0.6;
    width: 12;
    margin-right: 1;
  }

  & > .budget-left {
    width: 12;
    margin-right: 1;
  }

  & > .budget-input {
    width: 12;
  }

  & > .budget-sum {
    width: 12;
    opacity: 0.9;
    background: $surface;
    padding: 0 1;
    color: $text;
  }
}
